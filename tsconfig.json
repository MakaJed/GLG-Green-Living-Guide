{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,                          // allow importing .js files
    "checkJs": false,                         // don't type-check them
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,                     // skip checking JS/decl files
    "baseUrl": ".",                           
    "paths": {
      "@/*": ["./*"]
    },
    "typeRoots": ["./node_modules/@types", "./types"],
    "rootDir": ".",
    "jsx": "react-native",
    "target": "es2015",
    "downlevelIteration": true,
    "lib": ["dom", "es2015", "es2016", "es2017"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",               // include your .js modules
    "declarations.d.ts",     // if you still use manual declarations
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
